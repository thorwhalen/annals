{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thorwhalen/manicules/highlight.schema.json",
  "title": "manicules",
  "description": "A saved highlight, what may be changed on it, and the reader's settings.",
  "$defs": {
    "Highlight": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!settings$)[A-Za-z0-9_-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "target": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "title": {
                  "type": "string",
                  "maxLength": 500
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "id"
              ]
            },
            "part": {
              "default": "body",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "quote": {
              "type": "object",
              "properties": {
                "exact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "prefix": {
                  "type": "string",
                  "maxLength": 600
                },
                "suffix": {
                  "type": "string",
                  "maxLength": 600
                }
              },
              "required": [
                "exact"
              ]
            },
            "position": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "whole": {
              "type": "boolean"
            }
          },
          "required": [
            "source"
          ]
        },
        "comment": {
          "default": "",
          "type": "string",
          "maxLength": 10000
        },
        "tags": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "color": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "yellow",
                "green",
                "blue",
                "pink",
                "orange",
                "purple"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "type": "string",
          "minLength": 1
        },
        "modified": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "created"
      ]
    },
    "HighlightPatch": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "comment": {
          "default": "",
          "type": "string",
          "maxLength": 10000
        },
        "tags": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "color": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "yellow",
                "green",
                "blue",
                "pink",
                "orange",
                "purple"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Settings": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "color": {
          "default": "yellow",
          "type": "string",
          "enum": [
            "yellow",
            "green",
            "blue",
            "pink",
            "orange",
            "purple"
          ]
        },
        "showOthers": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "Collection": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Highlight"
      }
    }
  }
}
